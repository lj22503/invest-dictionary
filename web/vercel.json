{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/terms/CPI.html", "destination": "/terms/通货膨胀（CPI）", "permanent": true },
    { "source": "/terms/CPI", "destination": "/terms/通货膨胀（CPI）", "permanent": true },
    { "source": "/terms/通货膨胀.html", "destination": "/terms/通货膨胀（CPI）", "permanent": true },
    { "source": "/terms/通货膨胀", "destination": "/terms/通货膨胀（CPI）", "permanent": true },
    { "source": "/terms/降准.html", "destination": "/terms/降准（存款准备金率下调）", "permanent": true },
    { "source": "/terms/降准", "destination": "/terms/降准（存款准备金率下调）", "permanent": true },
    { "source": "/terms/指数基金.html", "destination": "/terms/指数基金（宽基指数 vs 行业指数）", "permanent": true },
    { "source": "/terms/指数基金", "destination": "/terms/指数基金（宽基指数 vs 行业指数）", "permanent": true },
    { "source": "/terms/比特币.html", "destination": "/terms/比特币（加密货币）", "permanent": true },
    { "source": "/terms/比特币", "destination": "/terms/比特币（加密货币）", "permanent": true },
    { "source": "/terms/预收款 _ 合同负债.html", "destination": "/terms/预收款 _ 合同负债（未来收入的蓄水池）", "permanent": true },
    { "source": "/terms/预收款 _ 合同负债", "destination": "/terms/预收款 _ 合同负债（未来收入的蓄水池）", "permanent": true },
    { "source": "/terms/降息.html", "destination": "/terms/降息 _ 加息", "permanent": true },
    { "source": "/terms/降息", "destination": "/terms/降息 _ 加息", "permanent": true },
    { "source": "/terms/应急金.html", "destination": "/terms/应急金（备用金）", "permanent": true },
    { "source": "/terms/应急金", "destination": "/terms/应急金（备用金）", "permanent": true },
    { "source": "/terms/股票（普通股）.html", "destination": "/terms/股票（普通股 _ 优先股）", "permanent": true },
    { "source": "/terms/股票（普通股）", "destination": "/terms/股票（普通股 _ 优先股）", "permanent": true },
    { "source": "/terms/扣非净利润.html", "destination": "/terms/扣非净利润（扣除非经常性损益）", "permanent": true },
    { "source": "/terms/扣非净利润", "destination": "/terms/扣非净利润（扣除非经常性损益）", "permanent": true },
    { "source": "/terms/央行.html", "destination": "/terms/货币政策工具", "permanent": true },
    { "source": "/terms/央行", "destination": "/terms/货币政策工具", "permanent": true },
    { "source": "/terms/货币政策.html", "destination": "/terms/货币政策工具", "permanent": true },
    { "source": "/terms/货币政策", "destination": "/terms/货币政策工具", "permanent": true },
    { "source": "/terms/茅指数 / 宁组合.html", "destination": "/terms/茅指数 _ 宁组合", "permanent": true },
    { "source": "/terms/茅指数 / 宁组合", "destination": "/terms/茅指数 _ 宁组合", "permanent": true },
    { "source": "/terms/货币供应量（M0(.*)", "destination": "/terms/货币供应量（M0_ M1_ M2）", "permanent": true },
    { "source": "/terms/", "destination": "/dictionary", "permanent": true },
    { "source": "/terms", "destination": "/dictionary", "permanent": true },
    { "source": "/index.html%23(.*)", "destination": "/dictionary", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/send-daily.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/send-daily",
      "schedule": "0 9 * * *"
    }
  ]
}
