<style>
  /* ===== InvestBuddy 主题变量 ===== */
  :root {
    --bg-paper: #F5F2EC;
    --accent: #C43A31;
    --accent-hover: #A33028;
    --ink: #2C2C2C;
    --ink-light: #5A4A3A;
    --border-dashed: #c4b5a0;
    --card-bg: #faf6ee;
  }

  /* ===== 外层包裹 ===== */
  body.term-page {
    background: var(--bg-paper);
    padding-top: 0;
  }

  /* ===== 面包屑 ===== */
  .term-breadcrumb {
    max-width: 720px;
    width: 100%;
    margin: 0 auto 1rem auto;
    padding: 0 1rem;
    font-size: 0.85rem;
    color: var(--ink-light);
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  .term-breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .term-breadcrumb a:hover {
    text-decoration: underline;
  }
  .term-breadcrumb .bc-sep {
    margin: 0 0.4rem;
    color: #b8a58e;
  }
  .term-breadcrumb .bc-current {
    color: var(--ink);
    font-weight: 500;
  }

  /* ===== 分享按钮区 ===== */
  .share-bar {
    max-width: 720px;
    width: 100%;
    margin: 0 auto 1.2rem auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  .share-bar .share-label {
    font-size: 0.82rem;
    color: var(--ink-light);
    margin-right: 0.3rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.85rem;
    border: 1.5px dashed var(--border-dashed);
    border-radius: 4px 8px 5px 7px;
    background: var(--card-bg);
    color: var(--ink);
    font-size: 0.82rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    font-family: "KaiTi", "楷体", serif;
  }
  .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 1px 4px rgba(196,58,49,0.15);
  }
  .share-btn.wechat-btn {
    position: relative;
  }
  .share-btn.wechat-btn .qr-popup {
    display: none;
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    border: 1.5px dashed var(--border-dashed);
    border-radius: 6px;
    padding: 0.8rem;
    box-shadow: 2px 3px 12px rgba(0,0,0,0.12);
    z-index: 100;
    text-align: center;
  }
  .share-btn.wechat-btn:hover .qr-popup {
    display: block;
  }
  .share-btn.wechat-btn .qr-popup img {
    width: 120px;
    height: 120px;
    background: #f0f0f0;
    display: block;
  }
  .share-btn.wechat-btn .qr-popup span {
    display: block;
    font-size: 0.7rem;
    color: #888;
    margin-top: 0.3rem;
  }
  .copy-toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #fff;
    padding: 0.5rem 1.2rem;
    border-radius: 6px;
    font-size: 0.88rem;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  }
  .copy-toast.show {
    opacity: 1;
  }

  /* ===== 导航区 ===== */
  .term-pager {
    max-width: 720px;
    width: 100%;
    margin: 1.8rem auto 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: "KaiTi", "楷体", "PingFang SC", sans-serif;
  }
  .term-pager a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1.5px dashed var(--border-dashed);
    border-radius: 4px 8px 5px 7px;
    background: var(--card-bg);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.88rem;
    transition: all 0.2s ease;
    max-width: 45%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .term-pager a:hover {
    border-color: var(--accent);
    box-shadow: 0 1px 4px rgba(196,58,49,0.15);
  }
  .term-pager .pager-disabled {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1.5px dashed #ddd;
    border-radius: 4px 8px 5px 7px;
    background: #f8f8f8;
    color: #bbb;
    font-size: 0.88rem;
    cursor: default;
  }

  /* ===== 关联词条 ===== */
  .term-related {
    max-width: 720px;
    width: 100%;
    margin: 1.5rem auto 0 auto;
    padding: 1rem 1.5rem;
    border: 1.5px dashed var(--border-dashed);
    border-radius: 6px 10px 7px 8px;
    background: var(--card-bg);
    font-family: "KaiTi", "楷体", "PingFang SC", sans-serif;
  }
  .term-related h3 {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 0.5rem;
    font-family: "KaiTi", "楷体", serif;
  }
  .related-links {
    font-size: 0.9rem;
    color: var(--ink-light);
    line-height: 1.8;
  }
  .related-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .related-links a:hover {
    text-decoration: underline;
  }

  /* ===== 返回目录 ===== */
  .term-back {
    max-width: 720px;
    width: 100%;
    margin: 1.5rem auto 0 auto;
    padding: 0 1rem;
    text-align: center;
    font-family: "KaiTi", "楷体", "PingFang SC", sans-serif;
  }
  .term-back a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .term-back a:hover {
    text-decoration: underline;
  }

  /* ===== 底部间距 ===== */
  .term-footer-spacer {
    height: 3rem;
  }

  /* ===== 响应式 ===== */
  @media (max-width: 600px) {
    .share-bar {
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .share-btn {
      padding: 0.35rem 0.7rem;
      font-size: 0.78rem;
    }
    .term-breadcrumb {
      font-size: 0.78rem;
    }
    .term-pager {
      flex-direction: column;
      align-items: stretch;
    }
    .term-pager a, .term-pager .pager-disabled {
      max-width: 100%;
      text-align: center;
    }
  }
</style>
