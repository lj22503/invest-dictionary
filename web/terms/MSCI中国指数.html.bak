<style>
/* ===== Reset & Base ===== */
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-size: 17px;
    scroll-behavior: smooth;
  }

  body {
    background: #f5efe0;
    background-image:
      radial-gradient(ellipse at 20% 10%, rgba(180,160,130,0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 90%, rgba(160,140,110,0.06) 0%, transparent 60%);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem 1rem 4rem;
    font-family:
      "KaiTi", "楷体", "STKaiti",
      "FangSong", "仿宋", "STFangsong",
      "Noto Serif SC", "Source Han Serif SC",
      "Songti SC", "宋体", "SimSun",
      "PingFang SC", "Microsoft YaHei",
      serif;
    color: #3a3a3a;
    line-height: 1.9;
    letter-spacing: 0.02em;
    -webkit-font-smoothing: antialiased;
  }

  /* ===== Paper Sheet ===== */
  .paper {
    max-width: 720px;
    width: 100%;
    background: #faf6ee;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 27px,
        rgba(180,155,120,0.06) 27px,
        rgba(180,155,120,0.06) 28px
      );
    border: 1.5px dashed #c4b5a0;
    border-radius: 4px 10px 6px 9px;
    padding: 3rem 2.5rem 2.5rem;
    box-shadow:
      2px 3px 0 rgba(60,45,25,0.06),
      5px 7px 14px rgba(60,45,25,0.10),
      inset 0 0 80px rgba(230,215,190,0.18);
    position: relative;
    overflow: visible;
  }

  .paper::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    width: 70px;
    height: 28px;
    background: rgba(220,205,175,0.55);
    border: 1px dashed #c4b5a0;
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }

  /* ===== Header Area ===== */
  .header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.8rem;
    position: relative;
  }

  .title-wrap {
    flex: 1;
  }

  .main-title {
    font-family: "KaiTi", "楷体", "STKaiti", "FangSong", "仿宋", serif;
    font-size: 3.2rem;
    font-weight: 400;
    color: #3a3a3a;
    line-height: 1.2;
    position: relative;
    display: inline-block;
    padding-bottom: 0.35em;
    letter-spacing: 0.15em;
  }

  .main-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 6px;
    background:
      repeating-linear-gradient(
        90deg,
        #e8784a 0px,
        #e8784a 4px,
        transparent 4px,
        transparent 10px,
        #e8784a 10px,
        #e8784a 12px,
        transparent 12px,
        transparent 18px
      );
    border-radius: 2px;
    opacity: 0.75;
  }

  .subtitle {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: #8b7a65;
    letter-spacing: 0.05em;
    font-style: italic;
  }

  /* ===== Card Divider ===== */
  .card-divider {
    text-align: center;
    margin: 2rem 0;
    position: relative;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-divider::before {
    content: '';
    display: block;
    width: 70%;
    height: 3px;
    background:
      repeating-linear-gradient(
        90deg,
        #c4b5a0 0px,
        #c4b5a0 6px,
        transparent 6px,
        transparent 16px,
        #c4b5a0 16px,
        #c4b5a0 22px,
        transparent 22px,
        transparent 36px
      );
    border-radius: 2px;
    opacity: 0.7;
  }

  .card-divider::after {
    content: '✂';
    position: absolute;
    font-size: 0.8rem;
    color: #b8a58e;
    opacity: 0.5;
    top: -4px;
    right: 12%;
    transform: rotate(10deg);
  }

  /* ===== Cards ===== */
  .card {
    position: relative;
    padding: 1.8rem 1.5rem 2rem;
    margin-bottom: 0.6rem;
    border: 1.5px dashed #c4b5a0;
    border-radius: 6px 14px 8px 11px;
    background: #fdfaf4;
    box-shadow: 1px 2px 0 rgba(60,45,25,0.04);
    transition: box-shadow 0.2s ease;
  }

  .card:hover {
    box-shadow: 2px 3px 8px rgba(60,45,25,0.10);
  }

  .card-number {
    position: absolute;
    top: -18px;
    left: -12px;
    width: 38px;
    height: 38px;
    border: 2px dashed #c4b5a0;
    border-radius: 48% 52% 50% 50% / 45% 55% 52% 48%;
    background: #faf6ee;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "KaiTi", "楷体", "STKaiti", serif;
    font-size: 1.1rem;
    color: #6b5e4e;
    box-shadow: 1px 1px 0 rgba(60,45,25,0.05);
    user-select: none;
  }

  .card-title {
    font-family: "KaiTi", "楷体", "STKaiti", "FangSong", "仿宋", serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: #3a3a3a;
    margin-bottom: 1.2rem;
    padding-bottom: 0.45em;
    display: inline-block;
    position: relative;
    letter-spacing: 0.08em;
  }

  .card-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 4px;
    background:
      repeating-linear-gradient(
        90deg,
        #d4745c 0px,
        #d4745c 3px,
        transparent 3px,
        transparent 7px,
        #d4745c 7px,
        #d4745c 10px,
        transparent 10px,
        transparent 14px
      );
    border-radius: 1px;
    opacity: 0.65;
  }

  .card-body {
    font-size: 0.95rem;
    color: #4a4035;
    line-height: 2.1;
    margin-bottom: 1rem;
  }

  .card-body p {
    margin-bottom: 0.7rem;
  }

  .card-body .highlight {
    position: relative;
    display: inline;
    padding: 0 0.15em;
  }

  .card-body .highlight::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 8px;
    background: rgba(232,120,74,0.18);
    z-index: -1;
    border-radius: 2px;
  }

  .card-body .tag {
    display: inline-block;
    background: rgba(232,120,74,0.10);
    color: #8b5040;
    padding: 0.1em 0.5em;
    border-radius: 3px 6px 4px 5px;
    border: 1px dashed rgba(232,120,74,0.30);
    font-size: 0.88rem;
    margin: 0 0.1em;
  }

  .step-list {
    list-style: none;
    padding-left: 0;
  }

  .step-list li {
    position: relative;
    padding-left: 1.8em;
    margin-bottom: 0.7rem;
  }

  .step-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background: #e8784a;
    border-radius: 50%;
    opacity: 0.7;
    box-shadow: 0 0 0 2px rgba(232,120,74,0.15);
  }

  .card-quote {
    border-left: 3px dashed #d4745c;
    padding-left: 1rem;
    margin: 1rem 0;
    color: #6b5040;
    font-style: italic;
    font-size: 0.92rem;
  }

  /* ===== Footer Area ===== */
  .footer-area {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 2px dashed #c4b5a0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    flex-direction: column;
  }

  .footer-sign {
    background: #faf6ee;
    border: 1.5px dashed #c4b5a0;
    border-radius: 3px 10px 5px 8px;
    padding: 0.6rem 1.2rem;
    font-family: "KaiTi", "楷体", "STKaiti", serif;
    font-size: 1rem;
    color: #5a4a3a;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    box-shadow: 1px 2px 0 rgba(60,45,25,0.05);
    width: 100%;
    justify-content: center;
  }

  .footer-sign .arrow {
    font-size: 1.3rem;
    color: #e8784a;
  }

  .footer-dash {
    width: 60%;
    height: 1px;
    border-top: 1px dashed #c4b5a0;
    margin: 0.3rem 0;
  }

  /* ===== Responsive ===== */
  @media (max-width: 600px) {
    html { font-size: 15px; }

    .paper {
      padding: 2rem 1.2rem 1.8rem;
      border-radius: 3px 8px 5px 7px;
    }

    .main-title {
      font-size: 2.4rem;
    }

    .card {
      padding: 1.5rem 1rem 1.5rem;
    }

    .card-title {
      font-size: 1.25rem;
    }

    .card-number {
      width: 32px;
      height: 32px;
      font-size: 1rem;
      top: -15px;
      left: -8px;
    }

    .card-body {
      font-size: 0.88rem;
      line-height: 1.9;
    }

    .footer-sign {
      font-size: 0.9rem;
      padding: 0.5rem 0.9rem;
    }

    .card-divider::after {
      right: 5%;
    }
  }

/* ===== 统一导航头部 ===== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 24px;
  background: rgba(245,242,236,0.92);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid #D9D4CC;
}
.site-header .brand {
  font-family: "Noto Serif SC", "KaiTi", "STKaiti", serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #2C2C2C;
  text-decoration: none;
  letter-spacing: 0.04em;
  display: inline-flex;
  align-items: baseline;
  gap: 8px;
}
.site-header .brand .en {
  font-size: 0.72rem;
  color: #C43A31;
  letter-spacing: 0.14em;
  font-style: italic;
  font-weight: 400;
}
.site-header nav {
  display: flex;
  gap: 18px;
  align-items: center;
}
.site-header nav a,
.site-header nav button {
  font-size: 0.88rem;
  color: #5A5A5A;
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  padding: 4px 2px;
  border-bottom: 2px solid transparent;
  transition: color 0.2s, border-color 0.2s;
}
.site-header nav a:hover,
.site-header nav button:hover {
  color: #C43A31;
  border-bottom-color: #C43A31;
}
@media (max-width: 560px) {
  .site-header { flex-direction: column; gap: 8px; padding: 12px 16px; }
  .site-header nav { gap: 14px; }
}

/* ===== 详情页导航适配 ===== */
body.term-page .site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
}
body.term-page {
  padding-top: 72px !important;
}
